{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "c4d5693f1d3596af74f7ac66b42face0",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // only the custom domain serves the app; the WCA redirect URI and the CORS list both name it
  "workers_dev": false,
  "preview_urls": false,
  // `npm run dev:worker` flips this to true to allow the test sign-in at /api/dev/login
  "define": { "__DEV_LOGIN__": "false" },
  // one SQLite-backed object per signed-in WCA account holds that account's solves, sessions, settings and sign-in tokens
  "durable_objects": { "bindings": [{ "name": "USERS", "class_name": "UserStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SYNC_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // secrets, set with `wrangler secret put`: WCA_APPLICATION_ID, WCA_SECRET, SESSION_SECRET
  "routes": [{ "pattern": "timer.serendeep.app", "custom_domain": true }]
}
