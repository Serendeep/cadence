{
  "name": "better-cstimer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "node electron/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "dist:linux": "npm run build && electron-builder --linux AppImage pacman",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "aes-js": "^3.1.2",
    "cubing": "^0.66.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "gan-web-bluetooth": "^3.0.2",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "description": "A faster, cleaner speedcubing timer with deep analysis, smart cube and Stackmat support.",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "author": {
    "name": "Serendeep",
    "email": "serendeep4@gmail.com"
  },
  "build": {
    "appId": "dev.serendeep.better-cstimer",
    "productName": "better-cstimer",
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "better-cstimer",
      "maintainer": "Serendeep <serendeep4@gmail.com>"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxkbcommon",
        "mesa",
        "libdrm",
        "at-spi2-core"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Connects to Bluetooth smart cubes and the GAN Smart Timer.",
        "NSMicrophoneUsageDescription": "Reads a Stackmat timer plugged into the audio input."
      }
    }
  }
}
