{
  "name": "cadence",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "node electron/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev --env-file .env.local --define __DEV_LOGIN__:true"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "aes-js": "^3.1.2",
    "cubing": "^0.66.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.11",
    "gan-web-bluetooth": "github:Serendeep/gan-web-bluetooth#v3.0.2-cadence.1",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "description": "A faster, cleaner speedcubing timer with deep analysis, smart cube and Stackmat support.",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "author": {
    "name": "Serendeep",
    "email": "serendeep4@gmail.com"
  },
  "build": {
    "appId": "dev.serendeep.cadence",
    "productName": "Cadence",
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/updateMode.cjs",
      "electron/backups.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "cadence",
      "maintainer": "Serendeep <serendeep4@gmail.com>",
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxkbcommon",
        "mesa",
        "libdrm",
        "at-spi2-core"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Connects to Bluetooth smart cubes and the GAN Smart Timer.",
        "NSMicrophoneUsageDescription": "Reads a Stackmat timer plugged into the audio input."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Serendeep",
        "repo": "cadence",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
